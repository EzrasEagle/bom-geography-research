{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EzrasEagle/bom-geography-research/research/schema/model.schema.json",
  "title": "BoM Geography Model Profile",
  "type": "object",
  "required": ["id", "name", "category", "summary", "key_claims", "primary_sources", "status"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["mesoamerica", "heartland", "baja", "south_america", "malay", "great_lakes", "internal", "hemispheric", "other"]
    },
    "proponents": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" },
    "core_map": {
      "type": "object",
      "properties": {
        "land_southward": { "type": "string" },
        "land_northward": { "type": "string" },
        "narrow_neck": { "type": "string" },
        "sidon": { "type": "string" },
        "landing": { "type": "string" },
        "cumorah": { "type": "string" }
      }
    },
    "key_claims": { "type": "array", "items": { "type": "string" } },
    "strengths_claimed": { "type": "array", "items": { "type": "string" } },
    "weaknesses_claimed_by_critics": { "type": "array", "items": { "type": "string" } },
    "primary_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "citation": { "type": "string" },
          "url": { "type": "string" },
          "year": { "type": "integer" }
        }
      }
    },
    "related_repos": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["active", "historical", "speculative", "archived"] },
    "updated": { "type": "string", "format": "date" }
  }
}
